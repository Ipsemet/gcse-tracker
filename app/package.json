{
  "name": "harry-gcse-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vite",
    "build": "npm run content:build && tsc -b && vite build",
