    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1",
    "zod": "^4.0.5",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.0.1"
  }
}
